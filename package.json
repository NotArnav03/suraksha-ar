{
  "name": "suraksha-ar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AR vocational safety training and competency verification for Jharkhand mining, steel and mica workers (SIH26041)",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "run:correct": "node --experimental-strip-types src/cli/run.ts --script correct",
    "run:trap": "node --experimental-strip-types src/cli/run.ts --script second-victim-trap",
    "run:seeds": "node --experimental-strip-types src/cli/run.ts --variants 5",
    "run:certify": "node --experimental-strip-types src/cli/run.ts --attempts 4 --script correct",
    "run:why": "node --experimental-strip-types src/cli/run.ts --script second-victim-trap --why",
    "run:credential": "node --experimental-strip-types src/cli/credential.ts",
    "run:tamper": "node --experimental-strip-types src/cli/credential.ts --tamper",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.185.4",
    "@types/webxr": "^0.5.24",
    "happy-dom": "^20.12.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "three": "^0.185.1"
  }
}
